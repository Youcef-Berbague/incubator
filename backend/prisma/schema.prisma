generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model acceleration_status {
  id                                                       Int       @id(map: "pk_acceleration_status") @default(autoincrement())
  acceleration_name                                        String?   @db.VarChar(30)
  project_project_acceleration_statusToacceleration_status project[] @relation("project_acceleration_statusToacceleration_status")
}

model departements {
  id                    Int                     @id(map: "pk_departement") @default(autoincrement())
  departement_name      String                  @db.VarChar(60)
  faculty_id            Int?
  departement_name_en   String?                 @db.VarChar(100)
  faculties             faculties?              @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_faculty_id")
  project               project[]
  project_registrations project_registrations[]
  users                 users[]
}

model evaluation_sheet {
  id          Int      @id(map: "pk_evaluation_sheet") @default(autoincrement())
  description String?  @db.VarChar(500)
  project_id  Int?
  jury_id     Int?
  jury        jury?    @relation(fields: [jury_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_jury_id")
  project     project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_project_id")
}

model faculties {
  id                    Int                     @id(map: "pk_faculty") @default(autoincrement())
  faculty_name          String                  @db.VarChar(60)
  faculty_name_en       String?                 @db.VarChar(100)
  departements          departements[]
  jury                  jury[]
  project_registrations project_registrations[]
}

model faq {
  id        Int       @id @default(autoincrement())
  question  String    @db.VarChar(500)
  answer    String
  createdat DateTime? @default(now()) @db.Timestamp(6)
  category  String?   @db.VarChar(50)
  isactive  Boolean?  @default(true)
  keywords  String?
  priority  Int?      @default(0)
  updatedat DateTime? @db.Timestamp(6)

  @@index([category], map: "idx_faq_category")
  @@index([isactive], map: "idx_faq_isactive")
  @@index([keywords], map: "idx_faq_keywords")
}

model jury {
  id                     Int                     @id(map: "pk_jury") @default(autoincrement())
  jury_code              String                  @unique @db.VarChar(100)
  date                   DateTime?               @db.Timestamp(6)
  so_partener_id         Int?
  location_id            Int?
  faculty_id             Int?
  evaluation_sheet       evaluation_sheet[]
  faculties              faculties?              @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_faculty_id")
  locations              locations?              @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_location_id")
  socio_economic_partner socio_economic_partner? @relation(fields: [so_partener_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_so_partener_id")
  jury_membres_relation  jury_membres_relation[]
  jury_project           jury_project[]
}

model jury_membre {
  membre_id             Int?
  role_id               Int?
  id                    Int                     @id @default(autoincrement())
  users                 users?                  @relation(fields: [membre_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_membre_id")
  jury_membre_role      jury_membre_role?       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mr_id")
  jury_membres_relation jury_membres_relation[]
}

model jury_membre_role {
  id          Int           @id(map: "pk_jmr_id") @default(autoincrement())
  name        String?       @db.VarChar(30)
  jury_membre jury_membre[]
}

model jury_membres_relation {
  membre_id   Int
  jury_id     Int
  jury        jury        @relation(fields: [jury_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_jury_id")
  jury_membre jury_membre @relation(fields: [membre_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_membre_id")

  @@id([membre_id, jury_id], map: "pk_jmr")
}

model jury_project {
  jury_id    Int
  project_id Int
  jury       jury    @relation(fields: [jury_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_jury_project_jury")
  project    project @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_jury_project_project")

  @@id([jury_id, project_id], map: "pk_jury_project")
}

model locations {
  id            Int        @id(map: "pk_locations") @default(autoincrement())
  location_name String     @db.VarChar(50)
  jury          jury[]
  training      training[]
}

model pre_incubation_status {
  id                                                           Int       @id(map: "pk_pre_incubation_status") @default(autoincrement())
  status_name                                                  String?   @db.VarChar(30)
  project_project_pre_incubation_statusTopre_incubation_status project[] @relation("project_pre_incubation_statusTopre_incubation_status")
}

model project {
  id                                                                         Int                    @id(map: "pk_project") @default(autoincrement())
  title                                                                      String                 @db.VarChar(250)
  project_code                                                               String?                @db.VarChar(100)
  finalpv                                                                    String?                @db.VarChar(1000)
  incubated                                                                  Boolean?
  progress_percent                                                           Int?                   @db.SmallInt
  team_id                                                                    Int?
  pre_incubation_status                                                      Int?
  acceleration_status                                                        Int?
  departement_id                                                             Int
  evaluation_sheet                                                           evaluation_sheet[]
  jury_project                                                               jury_project[]
  acceleration_status_project_acceleration_statusToacceleration_status       acceleration_status?   @relation("project_acceleration_statusToacceleration_status", fields: [acceleration_status], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_acceleration_status")
  pre_incubation_status_project_pre_incubation_statusTopre_incubation_status pre_incubation_status? @relation("project_pre_incubation_statusTopre_incubation_status", fields: [pre_incubation_status], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pre_incubation_status")
  departements                                                               departements           @relation(fields: [departement_id], references: [id], map: "fk_departement_id")
  project_team                                                               project_team?          @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_team_id")
  supervising                                                                supervising[]
}

model project_team {
  id            Int             @id(map: "pk_project_team") @default(autoincrement())
  project       project[]
  team_training team_training[]
  users         users[]
}

model refresh_tokens {
  id            Int       @id @default(autoincrement())
  token         String
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  user_agent    String?
  ip_address    String?
  user_id       Int
  remembreme    Boolean?  @default(false)
  uuid          String?
  fingerprint   Json?
  request_count Int?
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_user")

  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

model socio_economic_partner {
  id                  Int     @id(map: "pk_so_partner") @default(autoincrement())
  full_name           String  @db.VarChar(50)
  phone_number        String  @unique @db.VarChar(10)
  email               String  @unique @db.VarChar(100)
  professionel_adress String? @db.VarChar(150)
  jury                jury[]
}

model supervising {
  project_id    Int
  supervisor_id Int
  project       project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_supervising_project_id")
  users         users   @relation(fields: [supervisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_supervisor_id")

  @@id([project_id, supervisor_id], map: "pk_supervising")
}

model team_training {
  team_id      Int
  training_id  Int
  project_team project_team @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_team_id")
  training     training     @relation(fields: [training_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_training_id")

  @@id([team_id, training_id], map: "pk_team_training")
}

model training {
  id               Int             @id(map: "pk_training") @default(autoincrement())
  description      String?         @db.VarChar(400)
  location_id      Int?
  training_type_id Int?
  date             DateTime?       @db.Timestamp(6)
  team_training    team_training[]
  locations        locations?      @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_location_id")
  training_type    training_type?  @relation(fields: [training_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_training_type_id")
  user_training    user_training[]
}

model training_type {
  id       Int        @id(map: "pk_training_type") @default(autoincrement())
  type     String?    @db.VarChar(30)
  training training[]
}

model user_training {
  user_id     Int
  training_id Int
  training    training @relation(fields: [training_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_training_id")
  users       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_id")

  @@id([user_id, training_id], map: "pk_user_training")
}

model users {
  id             Int              @id(map: "pk_users") @default(autoincrement())
  email          String           @unique @db.VarChar(100)
  phone_number   String           @unique @db.VarChar(10)
  p_team_id      Int?
  departement_id Int?
  role           Int[]            @default([])
  status         String?          @db.VarChar(100)
  createdate     DateTime?        @default(now()) @db.Timestamp(6)
  updatedate     DateTime?        @db.Timestamp(6)
  password       String           @db.VarChar(255)
  academic_level String?          @db.VarChar(50)
  first_name     String           @db.VarChar(30)
  last_name      String           @db.VarChar(40)
  jury_membre    jury_membre[]
  refresh_tokens refresh_tokens[]
  supervising    supervising[]
  user_training  user_training[]
  project_team   project_team?    @relation(fields: [p_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_p_team_id")
  departements   departements?    @relation(fields: [departement_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_departement_id")
}

model project_registrations {
  id                       Int                        @id @default(autoincrement())
  title                    String                     @db.VarChar(250)
  faculty_id               Int?
  departement_id           Int?
  status                   String?                    @default("pending") @db.VarChar(30)
  submitted_at             DateTime?                  @default(now()) @db.Timestamp(6)
  departements             departements?              @relation(fields: [departement_id], references: [id], onUpdate: NoAction, map: "fk_reg_department")
  faculties                faculties?                 @relation(fields: [faculty_id], references: [id], onUpdate: NoAction, map: "fk_reg_faculty")
  registration_students    registration_students[]
  registration_supervisors registration_supervisors[]
}

model registration_students {
  id                    Int                   @id @default(autoincrement())
  registration_id       Int
  first_name            String                @db.VarChar(30)
  last_name             String                @db.VarChar(40)
  email                 String?               @db.VarChar(100)
  phone                 String?               @db.VarChar(20)
  academic_level        String?               @db.VarChar(50)
  project_registrations project_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reg_students_registration")
}

model registration_supervisors {
  id                    Int                   @id @default(autoincrement())
  registration_id       Int
  first_name            String                @db.VarChar(30)
  last_name             String                @db.VarChar(40)
  email                 String?               @db.VarChar(100)
  phone                 String?               @db.VarChar(20)
  project_registrations project_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reg_supervisors_registration")
}
